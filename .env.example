# Copie para .env na raiz do projeto: cp .env.example .env

# PostgreSQL
POSTGRES_USER=aai
POSTGRES_PASSWORD=aai_secret_change_me
POSTGRES_DB=aai_db
POSTGRES_PORT=5432

# Backend (FastAPI)
BACKEND_PORT=8000
JWT_SECRET=dev-jwt-secret-change-me
# URL do banco é montada no docker-compose; em execução local use:
# DATABASE_URL=postgresql://aai:aai_secret_change_me@localhost:5432/aai_db

# CORS — origens permitidas (separadas por vírgula). Inclua localhost E 127.0.0.1 se alternar na barra de endereço.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# Frontend — URL da API como o navegador acessa (porta publicada do backend no host).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Opcional: proxy /api no Next. Só preencha se souber que a rede Docker resolve o host abaixo.
# Ex.: INTERNAL_API_URL=http://backend:8000 e NEXT_PUBLIC_API_URL= (vazio) — exige build com esses valores.
# Padrão no compose: vazio = sem proxy (evita erro 500 se o hostname do backend não resolver no container).
INTERNAL_API_URL=
FRONTEND_PORT=3000

# ACBA: caminho do template DOCX dentro do container backend
ACBA_DOCX_TEMPLATE_PATH=/app/templates/acba_template.docx
# Comando LibreOffice (vazio = detectar soffice/libreoffice no PATH)
LIBREOFFICE_CMD=
